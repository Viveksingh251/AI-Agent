# ==============================================================================
# Company AI Agent - Environment Configuration Example
# Copy this file to .env and customize values for your deployment environment.
# ==============================================================================

# Application Settings
APP_NAME="Company AI Agent"
APP_ENV=development
DEBUG=false
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["*"]

# LLM Provider Configuration
# Set your OpenAI API key or compatible endpoint key (e.g., Azure OpenAI, vLLM, Ollama)
# If left empty, the application runs in self-contained mock/heuristic mode.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
LLM_PROVIDER=openai
LLM_TEMPERATURE=0.2
MAX_ITERATIONS=5

# Database Configuration
# Default uses local SQLite with async driver (aiosqlite)
# For production PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/company_agent
DATABASE_URL=sqlite+aiosqlite:///./company_agent.db

# Memory & Conversation History
MAX_HISTORY_MESSAGES=20

# Internal Enterprise Integrations & APIs
COMPANY_API_BASE_URL=https://api.internal.company.com
HTTP_TIMEOUT_SECONDS=10.0

