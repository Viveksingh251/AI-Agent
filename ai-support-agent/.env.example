# ==============================================================================
# AI Support Agent - Environment Configuration (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file to `.env`:
#    cp .env.example .env
# 2. Update placeholder values with your specific credentials and environment settings.
# 3. Never commit `.env` containing sensitive credentials into version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Runtime Environment
# ------------------------------------------------------------------------------
# Options: development | staging | production | testing (also accepts 'dev', 'prod')
APP_NAME="AI Customer Support Agent"
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8501"]
API_V1_PREFIX=/api/v1

# ------------------------------------------------------------------------------
# 2. Logging & Telemetry
# ------------------------------------------------------------------------------
# Options: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Set to 'true' to output structured JSON lines (recommended for production/Docker)
# Set to 'false' for human-readable colorized console logs during local development
LOG_JSON_FORMAT=true

# ------------------------------------------------------------------------------
# 3. LLM & Embedding Provider (OpenAI / Azure / Anthropic / Mock)
# ------------------------------------------------------------------------------
# Primary LLM provider: openai | azure | anthropic | mock
LLM_PROVIDER=openai

# OpenAI API Key (Required if LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-proj-abc123YourActualOpenAIKeyHere456789xyz

# Reasoning model name (e.g. gpt-4o-mini, gpt-4o, claude-3-5-sonnet-20240620)
OPENAI_MODEL_NAME=gpt-4o-mini
OPENAI_TEMPERATURE=0.1
MAX_TOKENS=2048
OPENAI_TIMEOUT_SECONDS=30.0

# Optional: Custom endpoint URL (e.g. for Azure OpenAI or local Ollama proxy)
# Example Azure: https://my-azure-resource.openai.azure.com/
# Example Ollama: http://localhost:11434/v1
OPENAI_BASE_URL=

# Text embedding model and vector dimension
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL_NAME=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# LangSmith Observability & Tracing (Optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=lsv2_pt_yourLangSmithKeyHere_0123456789
LANGCHAIN_PROJECT=ai-support-agent-dev

# OpenTelemetry Tracing (Optional — OTLP collector endpoint)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Sentry Error Tracking (Optional)
# SENTRY_DSN=https://yourKey@o0.ingest.sentry.io/0
# SENTRY_TRACES_SAMPLE_RATE=0.1

# ------------------------------------------------------------------------------
# 4. PostgreSQL Relational Database
# ------------------------------------------------------------------------------
# PostgreSQL connection string using asyncpg driver
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/support_agent_db
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30.0

# ------------------------------------------------------------------------------
# 5. Vector Store (FAISS Local + Optional pgvector / Qdrant)
# ------------------------------------------------------------------------------
# Vector backend choice: faiss | pgvector | qdrant | mock
VECTORSTORE_BACKEND=faiss

# FAISS Local Configuration (Used when VECTORSTORE_BACKEND=faiss)
FAISS_INDEX_DIR=./data/faiss_index
FAISS_INDEX_NAME=support_kb

# PGVector Configuration (Used when VECTORSTORE_BACKEND=pgvector)
PGVECTOR_TABLE_NAME=support_embeddings

# Retrieval parameters
VECTOR_SIMILARITY_METRIC=cosine
TOP_K_RETRIEVAL=4
SIMILARITY_THRESHOLD=0.75

# ------------------------------------------------------------------------------
# 6. Security & JWT Authentication
# ------------------------------------------------------------------------------
# IMPORTANT: In production, generate a secure random 32+ character hex string:
# openssl rand -hex 32
SECRET_KEY=dev-secret-key-please-generate-a-strong-random-key-for-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# 7. Redis Cache & Memory Checkpointer (Optional)
# ------------------------------------------------------------------------------
# Enable Redis for session memory caching and multi-worker LangGraph checkpoints
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_SECONDS=86400
REDIS_CONNECTION_TIMEOUT=5.0

# ------------------------------------------------------------------------------
# 8. Feature Flags & Operational Toggles
# ------------------------------------------------------------------------------
# Allow the agent to escalate frustrated or complex queries to human staff
ENABLE_ESCALATION=true

# Allow the agent to compose draft responses/emails for customer support tickets
ENABLE_EMAIL_DRAFTING=true

# Automatically generate a support ticket when an unresolved issue is detected
AUTO_TICKET_CREATION=true

# Evaluate customer sentiment (positive, neutral, frustrated, angry) on each turn
ENABLE_SENTIMENT_ANALYSIS=true

# Perform RAG knowledge base search for answering customer inquiries
ENABLE_RAG_SEARCH=true

# Enable token-by-token streaming on chat endpoints
ENABLE_STREAMING=true

# Safety limits: maximum turns per session before forcing human escalation
MAX_AGENT_TURNS=10

# Confidence threshold below which human supervisor review is triggered (0.0 - 1.0)
CONFIDENCE_THRESHOLD=0.70

# Destination email inbox where escalation alerts and summaries are sent
HUMAN_ESCALATION_EMAIL=support-tier2@company.com

# ------------------------------------------------------------------------------
# 9. Frontend (Streamlit)
# ------------------------------------------------------------------------------
STREAMLIT_SERVER_PORT=8501
BACKEND_API_URL=http://localhost:8000
